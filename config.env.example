# Copy to config.env and edit. config.env is gitignored.
# 启动脚本 scripts/start.ps1 / systemd 会加载本文件对应的 config.env。
HOST=0.0.0.0
PORT=7892
DOWNLOAD_DIR=./downloads
DB_PATH=./data/pixiv.db
WEB_DIR=./web
# 1=启动时扫描 DOWNLOAD_DIR 重建文件索引（保留名称/标签）；改过磁盘文件后可临时打开
SYNC_ON_START=0
PROXY_HOST=127.0.0.1
PROXY_PORT=7897
DOWNLOAD_DELAY_MS=1000
DOWNLOAD_TIMEOUT_SEC=30
